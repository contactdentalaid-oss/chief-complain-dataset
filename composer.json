{
  "name": "contactdentalaid/chief-complaints-dataset",
  "description": "Production-grade Clinical Master Dataset for Hospital Information Systems, EMR, Dental EMR, and Telemedicine",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Contact Dental Aid OSS",
      "email": "dev@contactdentalaid.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.42",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "ContactDentalAid\\ChiefComplaints\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ContactDentalAid\\ChiefComplaints\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan analyse src/ --level=max",
    "fix": "php-cs-fixer fix src/ --rules=@PSR12",
    "lint": "phpcs src/ --standard=PSR12"
  }
}
